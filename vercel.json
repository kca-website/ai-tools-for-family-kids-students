{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "hardening/*": false,
      "work/*": false
    }
  },
  "routes": [
    {
      "src": "/primary/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "dest": "/"
    },
    {
      "src": "/middle/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "dest": "/"
    },
    {
      "src": "/high/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "dest": "/"
    },
    {
      "src": "/preschool",
      "dest": "/preschool.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "inc": [
              "aitools4kids.vercel.app",
              "aitools4kids-kcawebsite.vercel.app",
              "aitools4kids-git-main-kcawebsite.vercel.app"
            ]
          }
        }
      ],
      "destination": "https://www.aitools4kids.gr/:path*",
      "statusCode": 301
    }
  ]
}
