{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "hardening/*": false,
      "work/*": false
    }
  },
  "routes": [
    {
      "src": "/(primary|middle|high)/(guardian|student)/(tools|advanced|prompts|quiz|tutor|guide)/?",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "dest": "/"
    },
    {
      "src": "/preschool/?",
      "dest": "/preschool.html"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "inc": [
              "aitools4kids.vercel.app",
              "aitools4kids-kcawebsite.vercel.app",
              "aitools4kids-git-main-kcawebsite.vercel.app"
            ]
          }
        }
      ],
      "destination": "https://www.aitools4kids.gr/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), payment=(), usb=(), camera=(self), microphone=(self)"
        }
      ]
    }
  ]
}
